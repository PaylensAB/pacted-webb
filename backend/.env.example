# Database (Supabase eller annan Postgres)
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Session (generera med: openssl rand -base64 32)
SESSION_SECRET="minst-32-tecken-slumpmassig-strang-byt-ut"
SESSION_COOKIE_NAME="pacted_session"

# App URL (för magic links och Stripe redirects)
NEXT_PUBLIC_APP_URL="https://pacted.se"

# Stripe (testmiljö = pk_test_..., produktion = pk_live_...)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID_PRIVATE="price_..."  # 29 kr/år (privatpersoner)
STRIPE_PRICE_ID_SMALL="price_..."    # 299 kr/år
STRIPE_PRICE_ID_MEDIUM="price_..."   # 699 kr/år
STRIPE_PRICE_ID_LARGE="price_..."    # 999 kr/år

# Resend (e-postleverans)
RESEND_API_KEY="re_..."
RESEND_FROM="pact:ed <hej@pacted.se>"

# S3-kompatibel storage (för tillfälliga PDF:er + signaturbilder)
# Använd Supabase Storage, Cloudflare R2 eller AWS S3
S3_ENDPOINT="https://<projekt>.supabase.co/storage/v1/s3"
S3_REGION="eu-north-1"
S3_BUCKET="pacted-transient"
S3_ACCESS_KEY_ID="..."
S3_SECRET_ACCESS_KEY="..."

# CatalystOne (varje kund har egna credentials — dessa är fallback för testning)
CATALYSTONE_BASE_URL="https://api.catalystone.com/v1"
CATALYSTONE_TEST_TENANT_ID=""
CATALYSTONE_TEST_API_KEY=""

# Säkerhet
ENCRYPTION_KEY="for-att-kryptera-customer-secrets-i-databasen-32-tecken"

# Loggning (Sentry, valfritt)
SENTRY_DSN=""
